<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Device list -->
    <record id="view_signage_device_list" model="ir.ui.view">
        <field name="name">signage.device.list</field>
        <field name="model">signage.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="expire_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Device form -->
    <record id="view_signage_device_form" model="ir.ui.view">
        <field name="name">signage.device.form</field>
        <field name="model">signage.device</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="description"/>
                        <field name="expire_date"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Content list -->
    <record id="view_signage_content_list" model="ir.ui.view">
        <field name="name">signage.content.list</field>
        <field name="model">signage.content</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="device_id"/>
                <field name="description"/>
                <field name="expire_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Content form -->
    <record id="view_signage_content_form" model="ir.ui.view">
        <field name="name">signage.content.form</field>
        <field name="model">signage.content</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="device_id"/>
                        <field name="description"/>
                        <field name="expire_date"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window actions -->
    <record id="action_signage_devices" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">signage.device</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_signage_content" model="ir.actions.act_window">
        <field name="name">Content</field>
        <field name="res_model">signage.content</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus -->
    <menuitem
        id="menu_signage_root"
        name="Digital Signage"
        sequence="10"
    />

    <menuitem
        id="menu_signage_devices"
        name="Devices"
        parent="menu_signage_root"
        action="action_signage_devices"
        sequence="10"
    />

    <menuitem
        id="menu_signage_content"
        name="Content"
        parent="menu_signage_root"
        action="action_signage_content"
        sequence="20"
    />
</odoo>